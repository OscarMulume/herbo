# ============================================================
# Herbo - Template base de donnees distant
# ------------------------------------------------------------
# Copier vers .env.local et completer LES VALEURS.
# Deux prestataires supportes : Supabase OU Neon (Serverless Postgres).
#
# RAPPEL SECURITE:
#  - NEXT_PUBLIC_* est embarque dans le bundle navigateur : valeurs
#    publiques uniquement (URL projet + cle ANON, jamais SERVICE_ROLE).
#  - Les secrets (service_role, DATABASE_URL directe, webhooks) restent
#    cotes serveur / Edge Functions.
# ============================================================

# --- Fournisseur actif : supabase | neon ---
DB_PROVIDER=supabase

# ====================================================================
# OPTION A - SUPABASE (recommandee pour Herbo : auth + storage inclus)
# ====================================================================
# URL du projet : https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Cle ANON (publique, protegee par RLS) - jamais la cle service_role
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle_anon_publique_de_votre_projet
# Pooler transactionnell + role direct sinon
SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.<ref>
SUPABASE_DB_PASSWORD=<mot_de_passe_du_role>
# Secret des Edge Functions uniquement
SUPABASE_SERVICE_ROLE_KEY=cle_service_role_secrete

# ====================================================================
# OPTION B - NEON (serverless Postgres, branche + pooler)
# ====================================================================
NEON_DATABASE_URL=postgresql://<user>:<password>@ep-<project>-pooler.<region>.aws.neon.tech/herbo?sslmode=require
NEON_HOST=ep-<project>-pooler.<region>.aws.neon.tech
NEON_PORT=5432
NEON_DATABASE=herbo
NEON_USERNAME=<user>
NEON_PASSWORD=<password>