# ==============================================================================
# VARIABLES D'ENVIRONNEMENT — COPIER CE FICHIER VERS ".env.local" ET COMPLÉTER.
# Aucune clé ne doit jamais être codée en dur dans le code source.
# ==============================================================================

# --- Supabase (public, exposé au navigateur : préfixé NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle_anon_publique_votre_projet

# --- Agrégeur de paiement local (Mobile Money / Cartes) ---
# Ces secrets ne vivent QUE dans l'environnement des Edge Functions
# (jamais dans le frontend / jamais exposés au navigateur).
PAYMENT_AGGREGATOR_BASE_URL=https://api.agregateur-paiement.local
PAYMENT_AGGREGATOR_API_KEY=cle_secrete_agregateur
# Secret HMAC utilisé par la Edge Function payment_webhook pour vérifier la
# signature des requêtes entrantes (en-tête `x-aggregator-signature`).
PAYMENT_AGGREGATOR_WEBHOOK_SECRET=secret_verification_webhook
NEXT_PUBLIC_PAYMENT_CALLBACK_URL=https://oscarmulume.github.io/herbo/checkout/confirm

# --- Logistique : coordonnées GPS du dépôt central (hub) ---
# Utilisées pour calculer la distance kilométrique de livraison (Haversine).
HUB_LAT=6.3703
HUB_LNG=2.3912

# --- Tests d'intégration (anti-survente) ---
# Points vers une base Supabase de test (locale `supabase start` ou dédiée)
# sur laquelle les migrations 0001-0003 sont appliquées.
# Le test est ignoré si ces variables sont absentes.
TEST_SUPABASE_URL=https://votre-projet.supabase.co
TEST_SERVICE_ROLE_KEY=cle_service_role_uniquement_pour_les_tests

# --- Divers ---
# Fuseau horaire business (West Central Africa, UTC+1).
DATABASE_TIMEZONE=Africa/Porto-Novo

# Niveau de journalisation du frontend (debug | info | warn | error).
NEXT_PUBLIC_LOG_LEVEL=info